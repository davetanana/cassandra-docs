# Copy to .env and edit. Every value is optional.

# Image under test. Pin an exact 5.0.x tag that matches the version the docs claim (see ../README.md "Version scope").
# To test a locally built tarball instead, see README.md "Testing a source build".
CASSANDRA_IMAGE=cassandra:5.0

# Per-node heap (G1 is the default collector, so set only MAX_HEAP_SIZE; HEAP_NEWSIZE is ignored with a warning). 3 nodes x 1G heap needs about 6 GB of Docker memory; 5 nodes about 9 GB.
MAX_HEAP_SIZE=1G

# Extra JVM options applied to every node (scenarios set this themselves when they need it).
JVM_EXTRA_OPTS_ALL=

# Optional: path to an apache/cassandra checkout, used by scenario 00 to run tools/check_docs.py
CASSANDRA_SRC=

# Helper images for scenario 07 (S3 backup). Keep them pinned; see AGENTS.md "Pitfalls".
# S3_IMAGE=adobe/s3mock@sha256:ab01a6946750f451ca215a47e91030695b260e4003b8a5a6201d25029b8fca92
# AWS_CLI_IMAGE=amazon/aws-cli:2.42.1
